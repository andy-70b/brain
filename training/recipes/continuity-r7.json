{
  "recipe": "continuity-r7",
  "base": "a70b-base-r3",
  "objective": "causal_lm",
  "sequence_length": 32768,
  "optimizer": {
    "name": "adamw",
    "learning_rate": 8e-06,
    "betas": [
      0.9,
      0.95
    ],
    "weight_decay": 0.1
  },
  "schedule": {
    "warmup_steps": 200,
    "max_steps": 4200,
    "kind": "cosine"
  },
  "gradient_clip": 1.0,
  "precision": "bfloat16",
  "corpus_manifest": "data/manifests/archive.json",
  "holdout_policy": "session-disjoint",
  "release_gate": "human-review"
}
