{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "origin",
    "digest",
    "state",
    "text"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "pending",
        "admitted",
        "quarantined",
        "retired"
      ]
    },
    "text": {
      "type": "string"
    }
  }
}
